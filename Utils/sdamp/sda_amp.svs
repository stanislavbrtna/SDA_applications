  sys.gui.setSelect(tName, 1);
  
  tBitRate = sys.gui.addText(1, 3, 4, 1, "", scr);
  tSmplRate = sys.gui.addText(6, 3, 3, 1, "", scr);
  sys.gui.setTxtAlign(tSmplRate, ALIGN_RIGHT);
  sys.gui.setXOffset(tSmplRate, 0);
  
  slider = sys.gui.addSliderH(1, 4, 8, 1, 1000, 0, scr);
