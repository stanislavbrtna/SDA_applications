  list_filter = "";
  
  #test stuff
  #qAdd(8);
  #qAdd(9);
  #qAdd(10);
  
  disMins = 3;
  
  mediaId = 0;
}

import "lib/inc/ddm.svs"

function clrLibScr {
  if(sLibIn) {
    sys.gui.destroy(sLibIn);
  }
  
  sLibIn = sys.gui.addScreen(1, 0, 8, 11, arg0);
  scrSpacer(sLibIn);
  sys.gui.setYscroll(sLibIn, 0);
  sys.gui.setYOffset(sLibIn, 8);
  sys.gui.setXcell(sLibIn, 38);
  sys.gui.setXscroll(sLibIn, -2);
  sys.gui.setBgRedraw(sLibIn, 0);
}


function ldQueue {
  clrLibScr(sQue);
  sys.fs.db.selectTable("folders");
  
  local y = 0;
  
  for(local i = 0; i < queueL; i++;) {
    sys.fs.db.selectTable("songs");
    
    if (not sys.fs.db.selectRowId(queue[i])) {
      break;
    }
    
    buttons[i] = sys.gui.addButton(
      0,
      y,
      7,
      1,
      " " + get_fname(sys.fs.db.getEntry("name")),
      sLibIn
    );
    sys.gui.setIcon(buttons[i], "song.sic");
    sys.gui.setXOffset(buttons[i], 6);
    sys.gui.setYOffset(buttons[i], 3);
  
    ids[i] = sys.fs.db.getEntry("id");
    
    if(queSelect != 0) {
      
      if (i == queSelect - 1) {
        y++;
        bQUp = sys.gui.addButton(0, y, 1, 1, "", sLibIn);
        sys.os.gui.setIcon(bQUp, ICON_UP);
        sys.gui.setXOffset(bQUp, 2);
  
        bQDown = sys.gui.addButton(1, y, 1, 1, "", sLibIn);
        sys.os.gui.setIcon(bQDown, ICON_DOWN);
        sys.gui.setXOffset(bQDown, 2);
        
        bQPlay = sys.gui.addButton(2, y, 3, 1, "Play", sLibIn);
        sys.gui.setIcon(bQPlay, "play_mini.sic");
        sys.gui.setXOffset(bQPlay, 6);
        sys.gui.setYOffset(bQPlay, 5);
        
        bQClose = sys.gui.addButton(6, y, 1, 1, "X", sLibIn);
        sys.gui.setXOffset(bQClose, 12);
      }
    }
    
    #print("Folder: " + sys.fs.db.getEntry("name"));
    y++;
  }
  
  sys.gui.setParam(sQBar, (y) * 28 + 8);
}


function ldFolders {
  clrLibScr(sLib);
  sys.gui.setVisible(bLQueue, 0);
  sys.fs.db.selectTable("folders");
  
  local y = 0;
  local yadd = 0;
  
  inFolders = 1;
  sys.gui.setValue(sLBar, folderScroll);
  sys.gui.setEvent(sLBar, EV_PRESSED);
  
  bListBk = 0;
  bListNext = 0;
  bListPrev = 0;
  
  if(folderBegin != 0) {
    bListPrev = sys.gui.addButton(0, 0, 7, 2,"", sLibIn);
    sys.gui.setIcon(bListPrev, "up.sic");
    sys.gui.setYOffset(bListPrev, 5);
    sys.gui.setXOffset(bListPrev, 110);
    yadd += 2;
  }
  
  for(local i = 0; i < 250; i++;) {
    sys.fs.db.selectTable("folders");
    
    if (not sys.fs.db.selectRow(i + folderBegin)) {
      continue;
    }
    
    buttons[y] = sys.gui.addButton(0, yadd, 7, 1, get_fname(sys.fs.db.getEntry("name")), sLibIn);
    ids[y] = sys.fs.db.getEntry("id");
    #print("Folder: " + sys.fs.db.getEntry("name"));
    y++;
    yadd++;
    
    if(y == len(ids)) {
      bListNext = sys.gui.addButton(0, yadd, 7, 2,"", sLibIn);
      sys.gui.setIcon(bListNext, "down.sic");
      sys.gui.setYOffset(bListNext, 5);
      sys.gui.setXOffset(bListNext, 110);
      yadd++;
      break;
    }
  }
  
  libLen = y;
  setSlider(yadd);
}


function ldFolder { # folder_id
  clrLibScr(sLib);
  local y = 0;
  local yadd = 0;
  sys.gui.setVisible(bLQueue, 1);
  
  
  inFolders = 0;
  bListBk = sys.gui.addButton(0, 0, 4, 1, "", sLibIn);
  sys.gui.addText(4, 0, 3, 1, "", sLibIn);
  sys.gui.setIcon(bListBk, "up_dir.sic");
  sys.gui.setYOffset(bListBk, 5);
  sys.gui.setXOffset(bListBk, 64);
  
  bListNext = 0;
  
  if(filesBegin != 0) {
    bListPrev = sys.gui.addButton(0, 1, 7, 2,"", sLibIn);
    sys.gui.setIcon(bListPrev, "up.sic");
    sys.gui.setYOffset(bListPrev, 5);
    sys.gui.setXOffset(bListPrev, 110);
    yadd += 2;
  }
  
  sys.fs.db.selectTable("folders");
  sys.fs.db.selectRowId(arg0);
  
  sys.gui.addText(0, 1 + yadd, 7, 1, get_fname(sys.fs.db.getEntry("name")), sLibIn);
  yadd++;
  
  sys.fs.db.selectTable("songs");
  sys.fs.db.selectRow(0);
  
  for(local b = 1; b < 250; b++;) {
    if (not sys.fs.db.selectRowNum("folderId", arg0)) {
      break;
    }
    
    if(filesBegin > b) {
      sys.fs.db.nextRow();
      continue;
    }
    
    buttons[y] = sys.gui.addButton(
      1 * dispQueBtn,
      y + 1 + yadd,
      7 - 1 * dispQueBtn,
      1,
      " " + get_fname(sys.fs.db.getEntry("name")),
      sLibIn
    );
    ids[y] = sys.fs.db.getEntry("id");
    
    if(not dispQueBtn) {
      
      if(ids[y] == currentSong) {
        selectList(buttons[y], 1);
      } else {
        selectList(buttons[y], 0);
      }
    }
    
    if(dispQueBtn) {
      bQUps[y] = sys.gui.addButton(0, y + 1 + yadd, 1, 1, "Q", sLibIn);
    }
    #print("Folder: " + sys.fs.db.getEntry("name"));
    y++;
    
    if(y == len(ids)) {
      bListNext = sys.gui.addButton(0, y + 1 + yadd, 7, 2,"", sLibIn);
      sys.gui.setIcon(bListNext, "down.sic");
      sys.gui.setYOffset(bListNext, 5);
      sys.gui.setXOffset(bListNext, 110);
      y++;
      break;
    }
    
    sys.fs.db.nextRow();
  }
  
  libLen = y;
  setSlider(y + yadd + 1);
}

function swap #(array, *a, *b)
{
  local a = arg1;
  local b = arg2;
  
  local temp = arg0[a];
  arg0[a] = arg0[b];
  arg0[b] = temp;
  
  local temp2 = ids[a];
  ids[a] = ids[b];
  ids[b] = temp2;
}

function partition #(int *L, int left, int right, sortstring)
{
  local L     = arg0;
  local left  = arg1;
  local right = arg2;
  
  local pivot = left;
  local p_val = L[pivot];
  
  while (left < right) {
    if(arg3 == "") {
      while (L[left] <= p_val)
        left++;
      while (L[right] > p_val)
        right--;
    } else {
      while (left < arg2 and strcmp(L[left], p_val, arg3) <= 0)
        left++;
      while (right > arg1 and strcmp(L[right], p_val, arg3) > 0)
        right--;
    }
    
    if (left < right)
      swap(L, left, right);
  }
  
  swap(L, pivot, right);
  return right;
}

function quicksort #(int *L, int start, int end)
{
  local L       = arg0;
  local start   = arg1;
  local ende    = arg2;
  local sortStr = "";
  
  if(arg3 + "" != "0") {
    sortStr = arg3;
  }
  
  if (start >= ende) return;
  local splitPoint = partition(L, start, ende, sortStr);
  quicksort(L, start, splitPoint - 1, sortStr);
  quicksort(L, splitPoint + 1, ende, sortStr);
}

function charcmp {
  local v = instr(arg1, arg0);
  if(v) return v;
  return len(arg1);
}

function strcmp { # str0 str1 sortsr
  local l = 0;
  if(len(arg0) > len(arg1)) {
    l = len(arg0);
  } else {
    l = len(arg1);
  }
  
  for(local i = 1; i <= l; i++;) {
    if(getcp(arg0, i) == getcp(arg1, i)) {
      continue;
    }
    return charcmp(getcp(arg0, i), arg2) - charcmp(getcp(arg1, i), arg2);
  }
}


function duplMp3 { # duplMp3(songId)
  sys.fs.db.selectTable("songs");
  sys.fs.db.selectRowId(arg0);
  print("duplicating: " + arg0);
  local name = sys.fs.db.getEntry("name");
  local path = sys.fs.db.getEntry("path");
  local folderId = sys.fs.db.getEntry("folderId");
  local lenght = sys.fs.db.getEntry("len");
  sys.fs.db.dropRow();
  sys.fs.db.newRow();
  sys.fs.db.setEntry("name", name);
  sys.fs.db.setEntry("path", path);
  sys.fs.db.setEntry("folderId", folderId);
  sys.fs.db.setEntry("len", lenght);
}


function orderFolder {
  local flen = 0;
  
  # load files and ids
  sys.fs.db.selectTable("songs");
  sys.fs.db.selectRow(0);
  
  for(local b = 0; b < len(buttons); b++;) {
    if (not sys.fs.db.selectRowNum("folderId", arg0)) {
      break;
    }
    
    buttons[b] = get_fname(sys.fs.db.getEntry("name"));
    ids[b] = sys.fs.db.getEntry("id");
    
    sys.fs.db.nextRow();
  }
  
  flen = b;
  
  sortstring = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
  quicksort(buttons, 0, flen - 1, sortstring);
  
  # print("After:"); 
  # for(i = 0; i < flen; i++;) {
  #   print(i + ": " + buttons[i]);
  # }
  
  # write new ordered entries, remove old
  for(local i = 0; i < flen; i++;) {
    duplMp3(ids[i]);
  }
  
  sys.fs.db.sync();
}


function queFolder {
  local flen = 0;
  
  # load files and ids
  sys.fs.db.selectTable("songs");
  sys.fs.db.selectRow(0);
  
  for(local b = 0; b < len(buttons); b++;) {
    if (not sys.fs.db.selectRowNum("folderId", arg0)) {
      break;
    }
    
    ids[b] = sys.fs.db.getEntry("id");
    
    sys.fs.db.nextRow();
  }
  
  flen = b;

  for(local i = 0; i < flen; i++;) {
    qAdd(ids[i]);
  }
  
}

function getFolder {
  for(arg2 = len(arg0); arg2 > 0; arg2--;) {
    if (getcp(arg0, arg2) == "/") {
      return substr(arg0, 0, arg2);
    }
  }
  return ".";
}


function lz {
  if(len("" + arg0) == 1) {
    return "0" + arg0;
  }
  return arg0;
}

function getMin {
  return arg0/60 + ":" + lz(arg0%60);
}


function get_fname {
  for(arg2 = len(arg0); arg2 > 0; arg2--;) {
    if (getcp(arg0, arg2) == "/") {
      return substr(arg0, arg2 + 1, len(arg0));
    }
  }
  return arg0;
}

##=============================================================================
##========================= Queue Functions ===================================

function qAdd {
  if(queueL + 1 >= len(queue)) {
    #sys.os.error("Queue full.");
    return;
  }
  
  queue[queueL] = arg0;
  queueL++;
}

function qGet {
  local val = queue[0];
  
  for (local i = 0; i < len(queue) - 1; i++;) {
    queue[i] = queue[i + 1];
  }
  queue[len(queue) - 1] = 0;
  queueL--;
  
  return val;
}

##=============================================================================
##========================= Playback functions ================================

function getRndFrFldr {
  sys.fs.db.selectTable("folders");
  sys.fs.db.selectRowId(arg0);
  
  local song = rnd()%sys.fs.db.getEntry("files");
  
  sys.fs.db.selectTable("songs");
  
  for(local i = 0; i <= song; i++;) {
    if (not sys.fs.db.selectRowNum("folderId", arg0)) {
      return 0;
    }
    
    if(i != song)
      sys.fs.db.nextRow();
  }
  
  return sys.fs.db.getEntry("id");
}

function playNext {
  sys.pcm.stop(mediaId);
  
  if(not sys.gui.getGhost(bLoop)) {
    playNo(currentSong);
    return;
  }
  
  if(queStopFlg) {
    queStopFlg = 0;
    stopPlayback();
    return;
  }
  
  if(queueL) {
    playNo(qGet());
    
    if(sys.os.gui.getMainScr() == sQue) {
      ldQueue();
    }
    
    if(queueL == 0 and sys.gui.getValue(bQStopEn)) {
      queStopFlg = 1;
    }
    return;
  }
  
  sys.fs.db.selectTable("songs");
  
  if(random == 0) {
    sys.fs.db.selectRowId(currentSong);
    sys.fs.db.nextRow();
    
    if (not sys.fs.db.selectRowNum("folderId", currentFolder)) {
      stopPlayback();
      return;
    }
    
    print("next: " + sys.fs.db.getEntry("name"));
    playNo(sys.fs.db.getEntry("id"));
  }
  
  if(random == 1) {
    # Folder
    local song = getRndFrFldr(currentFolder);
    
    while (song == currentSong or song == 0) {
      song = getRndFrFldr(currentFolder);
    }
    
    playNo(song);
  }
  
  if(random == 2) {
    # Full library
    local rows = sys.fs.db.getRowCount();
    
    if (rows == 0) {
      sys.os.error("Media library is empty, please rescan it.");
      return;
    }
    
    if(not sys.fs.db.selectRow(rnd()%(rows - 1) + 1)) {
      sys.os.error("Row select failed.");
      return;
    }
    
    print("next: " + sys.fs.db.getEntry("name"));
    playNo(sys.fs.db.getEntry("id"));
  }
}


function playPrev {
  for (local i = 0; i < len(prevSongs) - 1; i++;) {
    prevSongs[i] = prevSongs[i + 1];
  }
  prevSongs[len(prevSongs) - 1] = 0;
  if(prevSongs[0] != 0) {
    playNo(prevSongs[0]);
  } else {
    stopPlayback();
  }
}


function selectList { # id, play0-1
  if(arg1) {
    sys.gui.setIcon(arg0, "play_mini.sic");
    sys.gui.setXOffset(arg0, 11);
    sys.gui.setYOffset(arg0, 5);
  } else {
    sys.gui.setIcon(arg0, "song.sic");
    sys.gui.setXOffset(arg0, 6);
    sys.gui.setYOffset(arg0, 3);
  }
}


function playNo { # song id
  sys.fs.db.selectTable("songs");
  if(not sys.fs.db.selectRowId(arg0)) {
    sys.os.error("Song no " + arg0 + " not found!");
    return;
  }

  local in = 0;
  
  if(not inFolders or sys.os.gui.getMainScr() == sSearch) {
    for(in = 0; in < len(ids); in++;) {
      if(ids[in] == currentSong) {
        selectList(buttons[in], 0);
      }
    }
  }
  
  currentSong = sys.fs.db.getEntry("id");
  currentFolder = sys.fs.db.getEntry("folderId");
  
  if(not inFolders or sys.os.gui.getMainScr() == sSearch) {
    for(in = 0; in < len(ids); in++;) {
      if(ids[in] == currentSong) {
        selectList(buttons[in], 1);
      }
    }
  }
  
  local dur = sys.fs.db.getEntry("len");
  
  if (dur > 0) {
    dur--;
  }
  
  playFile(sys.fs.db.getEntry("path"), dur);
  
  if(prevSongs[0] == arg0) {
    return;
  }
  
  for (local i = len(prevSongs) - 1; i > 0; i--;) {
    prevSongs[i] = prevSongs[i - 1];
  }
  
  prevSongs[0] = arg0;
}


function playFile { # path, duration
  if(arg0 == "") {
    return;
  }

  duration = arg1;
  
  sys.gui.setParam(slider, duration);
  sys.gui.setValue(slider, 0);
  sys.gui.setStr(tName, get_fname(arg0));
  sys.gui.setStr(tDur, "0:00/" + getMin(duration));
  sys.gui.setStr(tSmplRate, float(sys.pcm.getSmplRate(arg0))/1000.0  + "kHz");
  sys.gui.setVisible(tSmplRate, 1);
  
  local bitrate = sys.pcm.getBitRate(arg0);
  if(bitrate) {
    sys.gui.setStr(tBitRate, bitrate + "kbps");
    sys.gui.setVisible(tBitRate, 1);
  } else {
    sys.gui.setVisible(tBitRate, 0);
  }
  
  mediaId = sys.pcm.play(arg0);
  fname = arg0;
  sys.time.setTimer(duration * 1000, &playNext);
  playFlg = 1;
  pauseFlg = 0;
  sys.hw.btn.stdbyEn(1);
}


function stopPlayback {
  duration = 0;
  sys.time.clearTimer();
  sys.time.setTimer(disMins * 60 * 1000, &disableKeys);
  sys.pcm.stop(mediaId);
  playFlg = 0;
  pauseFlg = 0;
}

function playPause {
  if (playFlg == 0 or sys.pcm.getId() != mediaId) {
    if (currentSong != 0) {
      playNo(currentSong);
      playFlg = 1;
    } else {
      if (queueL) {
        playNo(qGet());
      }
    }
  } else {
    pauseFlg = 1 - pauseFlg;
    print("pausing: " + pauseFlg);
    sys.pcm.setPause(pauseFlg, mediaId);
    if(pauseFlg) {
      sys.time.clearTimer();
      sys.time.setTimer(disMins * 60 * 1000, &disableKeys);
    } else {
      sys.hw.btn.stdbyEn(1);
      print("setting timer...");
      sys.time.setTimer((duration - sys.gui.getValue(slider)) * 1000, &playNext);
    } 
  }
}

function pausePlayback {
  pauseFlg = 1;
  sys.pcm.setPause(pauseFlg, mediaId);
  sys.time.clearTimer();
  sys.time.setTimer(60 * 1000, &disableKeys);
}

function disableKeys {
  print("keys disabled");
  sys.hw.btn.stdbyEn(0);
}

##=============================================================================
##========================= GUI updates =======================================

function setSlider {
  sys.gui.setParam(sLBar, (arg0) * 28);
  sys.gui.setScrollLim(sLibIn, 0, 0, 0, (arg0) * 28);
}

function handleList {
  for(local i = 0; i < libLen; i++;) {
    if(sys.gui.getEventC(buttons[i]) == EV_RELEASED) {
      if(inFolders) {
        folderScroll = sys.gui.getValue(sLBar);
        sys.gui.setValue(sLBar, 0);
        sys.gui.setEvent(sLBar, EV_PRESSED);
        filesBegin = 0;
        dispFolder = ids[i];
        ldFolder(ids[i]);
        inFolders = 0;
      } else {
        playNo(ids[i]);
      }
    }
    
    if(not inFolders) {
      if(dispQueBtn) {
        if(sys.gui.getEventC(bQUps[i]) == EV_RELEASED) {
          qAdd(ids[i]);
        }
      }
      
      if(sys.gui.getEventC(bLQueue) == EV_RELEASED) {
        dispQueBtn = 1 - dispQueBtn;
        ldFolder(dispFolder);
      }
    }
  }
  
  if(not inFolders) {
    if(sys.gui.getEventC(bListBk) == EV_RELEASED) {
      ldFolders();
    }
  }
  
  if(bListNext) {
    if(sys.gui.getEventC(bListNext) == EV_RELEASED) {
      if(not inFolders) {
        filesBegin += len(buttons);
        ldFolder(dispFolder);
      } else {
        folderBegin += len(buttons);
        ldFolders();
      }
      sys.gui.setValue(sLBar, 0);
      sys.gui.setEvent(sLBar, EV_PRESSED);
    }
  }
  
  if(bListPrev) {
    if(sys.gui.getEventC(bListPrev) == EV_RELEASED) {
      print("in folders: " + inFolders);
      if(not inFolders) {
        filesBegin -= len(buttons);
        if(filesBegin < 0) {
          filesBegin = 0;
        }
        ldFolder(dispFolder);
      } else {
        folderBegin -= len(buttons);
        if(folderBegin < 0) {
          folderBegin = 0;
        }
        ldFolders();
      }
      sys.gui.setValue(sLBar, sys.gui.getParam(sLBar));
      sys.gui.setEvent(sLBar, EV_PRESSED);
    }
  }
  
  if(sys.gui.getEventC(sLBar)) {
    sys.gui.setYscroll(sLibIn, sys.gui.getValue(sLBar));
  } else if(sys.gui.getValue(sLBar) != sys.gui.getYscroll(sLibIn)) {
    sys.gui.setValue(sLBar, sys.gui.getYscroll(sLibIn));
  }
}

 # call return for FSL
function callRet {
  if(arg0 == "") {
    return;
  }
  
  print("argument0: " + arg0);
  sys.gui.setStr(btn, "-> " + arg0 + "(" + arg1 + ")");
  
  print("folder: " + getFolder(arg0) + " (" + arg1 + ") Fname: " + get_fname(arg0));
  inApps = arg1;
  sys.fs.chDir(inApps);
  sys.fs.chDir(getFolder(arg0));
  duration = 0;
  playFile(get_fname(arg0));
}

function ldSearch {
  if(sLibIn)
    sys.gui.destroy(sLibIn);
  
  sLibIn = 0;
  searchLen = 0;
  sys.os.showKbd();
  sys.gui.setTxtAct(tSearch);
}

function updSearch {
  list_filter = sys.os.gui.handleText(tSearch, list_filter);
  
  if (list_filter != list_filter_pr) {
    list_filter_t = sys.time.getAppUptime() + 250;
  }
  
  if (sys.time.getAppUptime() >= list_filter_t and list_filter_t != 0) {
    
    for(local b = 0; b < searchLen; b++;) {
      sys.gui.destroy(buttons[b]);
    }
    
    local y = 0;
    
    if(len(list_filter) > 1) {
      sys.fs.db.selectTable("songs");
      sys.fs.db.selectRow(0);
      
      
      local b;
      for(local b = 1; b < 250; b++;) {
        if (not sys.fs.db.selectRowStr("name", list_filter, 0, 0)) {
          break;
        }
        
        # load
        buttons[y] = sys.gui.addButton(
          0,
          y,
          7,
          1,
          " " + get_fname(sys.fs.db.getEntry("name")),
          sSeaIn
        );
        ids[y] = sys.fs.db.getEntry("id");
        
        selectList(buttons[y], ids[y] == currentSong);
      
        y++;
        
        if(y >= len(ids)) {
          break;
        }
        
        sys.fs.db.nextRow();
      }
      list_filter_t = 0;
      sys.gui.setParam(sSBar, searchLen*32);
    }
    searchLen = y;
  }
  
  list_filter_pr = list_filter;
  
  if (sys.gui.getEventC(bSClose) == EV_RELEASED or sys.os.kbdGetState() == 0) {
    for(local b = 0; b < searchLen; b++;) {
      sys.gui.destroy((buttons[b]));
    }
    list_filter = "";
    list_filter_pr = "";
    
    if(inFolders) {
      ldFolders();
    } else {
      ldFolder(dispFolder);
    }
    sys.os.gui.setMainScr(sLib);
    sys.os.hideKbd();
    return;
  }
  
  if(sys.gui.getEvent(sSBar)) {
    sys.gui.setYscroll(sSeaIn, sys.gui.getValue(sSBar) - 6);
  }
  
  for(local b = 0; b < searchLen; b++;) {
    if (sys.gui.getEventC(buttons[b]) == EV_RELEASED) {
      playNo(ids[b]);      
    }
  }
}

function updMain {
  if (sys.gui.getEventC(bPlay) == EV_RELEASED) {
    playPause();
  }
  
  if (sys.gui.getEventC(bStop) == EV_RELEASED) {
    stopPlayback();
  }
  
  if(sys.gui.getEventC(bNext) == EV_RELEASED) {
    playNext();
  }
  
  if(sys.gui.getEventC(bPrev) == EV_RELEASED) {
    playPrev();
  }
  
  if (sys.gui.getEventC(bLibrary) == EV_RELEASED) {
    if(inFolders) {
      ldFolders();
    } else {
      ldFolder(dispFolder);
    }
    sys.os.gui.setMainScr(sLib);
  }
  
  if (sys.gui.getEventC(bQueue) == EV_RELEASED) {
    queSelect = 0;
    ldQueue();
    sys.os.gui.setMainScr(sQue);
  }
  
  if (sys.gui.getEventC(bLoop) == EV_RELEASED) {
    sys.gui.setGhost(bLoop, 1 - sys.gui.getGhost(bLoop));
  }
  
  if (sys.gui.getEventC(bRandom) == EV_RELEASED) {
    mRandom = ddm_create(bRandom);
    ddm_width = 5;
    ddm_add_btn("All songs");
    sys.gui.setIcon(ddm_get_id(1), "icons/shuffle-mini.sic");
    sys.gui.setYOffset(ddm_get_id(1), 3);
    ddm_add_btn("Folder");
    sys.gui.setIcon(ddm_get_id(2), "icons/rnd-folder.sic");
    sys.gui.setYOffset(ddm_get_id(2), 3);
    ddm_add_btn("Off");
    sys.gui.setIcon(ddm_get_id(3), "icons/rnd-off.sic");
    sys.gui.setYOffset(ddm_get_id(3), 3);
  }
  
  i = ddm_handle(mRandom);
  if (i > 0) {
    if (i == 1) {
      random = 2;
      sys.gui.setGhost(bRandom, 0);
      sys.gui.setIcon(bRandom, "shuffle.sic");
    }
    if (i == 2) {
      random = 1;
      sys.gui.setGhost(bRandom, 0);
      sys.gui.setIcon(bRandom, "icons/rnd-folder.sic");
    }
    if (i == 3) {
      random = 0;
      sys.gui.setGhost(bRandom, 1);
      sys.gui.setIcon(bRandom, "icons/rnd-off.sic");
    }
    ddm_exit();
  }
  
  local p = sys.pcm.getPos(mediaId);
  
  if(sys.gui.getValue(slider) != p and not sys.gui.getEvent(slider)) {
    #print("currentPos " + p);
    sys.gui.setStr(tDur, getMin(p) + "/" + getMin(duration));
    sys.gui.setValue(slider, p);
  }
  
  
  if (sys.gui.getEventC(slider) == EV_RELEASED) {
    sys.pcm.seek(sys.gui.getValue(slider), mediaId);
    sys.time.clearTimer();
    sys.time.setTimer((duration - sys.gui.getValue(slider)) * 1000, &playNext);
    print("timer se to " + (duration - sys.gui.getValue(slider)) + "s");
  }
  
  if(sys.gui.getEvent(slVol)) {
    sys.pcm.setVolume(sys.gui.getValue(slVol));
  } else {
    if(sys.pcm.getVolume() != sys.gui.getValue(slVol)) {
      sys.gui.setValue(slVol, sys.pcm.getVolume());
    }
  }
  sys.gui.setEvent(slVol, EV_NONE);
}


function updLib {
  if (sys.gui.getEventC(bLBack) == EV_RELEASED) {
    sys.os.gui.setMainScr(scr);
  }
  
  if (sys.gui.getEventC(bLSearch) == EV_RELEASED) {
    ldSearch();
    sys.os.gui.setMainScr(sSearch);
    return;
  }
  
  if (sys.gui.getEventC(bLfolder) == EV_RELEASED) {
    mFolder = ddm_create(bLfolder);
    ddm_width = 6;
    ddm_add_btn("Rescan library");
    ddm_add_btn("Show current");
    if(not inFolders) {
      ddm_add_btn("Queue all");
      ddm_add_btn("Sort");
    } 
    
    if(currentSong == 0) {
      ddm_gray(2, 1);
    }
  }
  
  i = ddm_handle(mFolder);
  if (i > 0) {
    if (i == 1) {
      spinnerInit();
      dbCheck();
      ldFolders();
      sys.os.setRedraw();
    }
    if (i == 2) {      
      dispFolder = currentFolder;
      inFolders = 0;
      
      sys.fs.db.selectTable("songs");
      sys.fs.db.selectRow(0);
      
      local b;
      for(local b = 1; b < 250; b++;) {
        if (not sys.fs.db.selectRowNum("folderId", currentFolder)) {
          break;
        }
        
        if (sys.fs.db.getEntry("id") == currentSong) {
          break;
        }
    
        sys.fs.db.nextRow();
      }
      
      filesBegin = (b/len(ids)) * len(ids);
      print("len: " + filesBegin + " b: " + b);
      
      ldFolder(currentFolder);
      
      local scroll = (b - filesBegin) * 32;
      if(scroll > sys.gui.getParam(sLBar)) {
        sys.gui.setValue(sLBar, sys.gui.getParam(sLBar));
      } else {
        sys.gui.setValue(sLBar, scroll);
      }
      sys.gui.setEvent(sLBar, EV_PRESSED);
      
    }
    if (i == 3) {
      queFolder(dispFolder);
      ldFolder(dispFolder);
    }
    if (i == 4) {
      # Sort
      orderFolder(dispFolder);
      ldFolder(dispFolder);
    }
    ddm_exit();
  }
  
  handleList();
}

function updQueue {
  if (sys.gui.getEventC(bQBack) == EV_RELEASED) {
    sys.os.gui.setMainScr(scr);
  }
  
  for(local i = 0; i < queueL; i++;) {
    if(sys.gui.getEventC(buttons[i]) == EV_RELEASED) {
      queSelect = i + 1;
      ldQueue();
    }
    
    if(queSelect != 0) {
      if (i == queSelect - 1) {
        
        if(queSelect != 1 and sys.gui.getEventC(bQUp) == EV_RELEASED) {
          local prac = queue[i - 1];
          queue[i - 1] = queue[i];
          queue[i] = prac;
          queSelect--;
          ldQueue();
        }
        
        if(queSelect != queueL and sys.gui.getEventC(bQDown) == EV_RELEASED) {
          local prac = queue[i];
          queue[i] = queue[i + 1];
          queue[i + 1] = prac;
          queSelect++;
          ldQueue();
        }
        
        if(sys.gui.getEventC(bQPlay) == EV_RELEASED) {
          playNo(queue[i]);
        }
        
        if(sys.gui.getEventC(bQClose) == EV_RELEASED) {
          for (local g = i; g < len(queue) - 1; g++;) {
            queue[g] = queue[g + 1];
          }
          queue[len(queue) - 1] = 0;
          queueL--;
          if(queSelect != 1) {
            queSelect--;
          }
          
          ldQueue();
        }
      }
    }
  }
  
  if(sys.gui.getEvent(sQBar)) {
    sys.gui.setYscroll(sLibIn, sys.gui.getValue(sQBar) - 6);
  }
}


function update {
  local bkBtn = 0;
  
  if(sys.hw.getLcdState()) {
    if(sys.os.gui.getMainScr() == scr) {
      updMain();
    }
    
    if(sys.os.gui.getMainScr() == sLib) {
      updLib();
      bkBtn = bLBack;
    }
    
    if(sys.os.gui.getMainScr() == sQue) {
      updQueue();
      bkBtn = bQBack;
    }
    
    if(sys.os.gui.getMainScr() == sSearch) {
      updSearch();
      bkBtn = bSClose;
    }
  }
  
  # handle pause on jack remove
  if(sys.pcm.getDevice() == 1 and oldDevice == 2) {
    pausePlayback();
  }
  
  oldDevice = sys.pcm.getDevice();
  
  # arg2: [num]back_btn_id - when 0, app is suspended upon back button press
  if(sys.hw.getLcdState()) {
    sys.os.gui.btnCtrl(sys.os.gui.getMainScr(), bkBtn);
  } else {
    if(sys.hw.btn.getEvent(BTN_RIGHT) == EV_PRESSED) {
      playNext();  
    }
    sys.hw.btn.clrEvent(BTN_RIGHT);
    
    if(sys.hw.btn.getEvent(BTN_B) == EV_PRESSED) {
      playPause();
    }
    sys.hw.btn.clrEvent(BTN_B);
    
    if(sys.hw.btn.getEvent(BTN_UP) == EV_PRESSED) {
      if(sys.gui.getValue(slVol) + 100 < 1000) {
        sys.gui.setValue(slVol, sys.gui.getValue(slVol) + 100);
      } else {
        sys.gui.setValue(slVol, 1000);
      }
      sys.pcm.setVolume(sys.gui.getValue(slVol));
    }
    sys.hw.btn.clrEvent(BTN_UP);
    
    if(sys.hw.btn.getEvent(BTN_DOWN) == EV_PRESSED) {
      if(sys.gui.getValue(slVol) - 100 > 0) {
        sys.gui.setValue(slVol, sys.gui.getValue(slVol) - 100);
      } else {
        sys.gui.setValue(slVol, 0);
      }
      sys.pcm.setVolume(sys.gui.getValue(slVol));
    }
    sys.hw.btn.clrEvent(BTN_DOWN);
  }
}


function exit {
  sys.pcm.stop(mediaId);
}
