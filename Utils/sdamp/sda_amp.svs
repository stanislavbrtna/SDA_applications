    prevSongs[i] = 0;
  }
  
  currentSong = 0;
  currentFolder = 0;
  
  randomMode = 0; # 0 - off, 1 - folder, 2 - all
  
  folderBegin = 0;
  filesBegin = 0;
  
  folderScroll = 0;
  
  mRandom = 0;
  mFolder = 0;
  
  bListNext = 0;
  bListPrev = 0;
  
  dispFolder = 0;
  dispQueBtn = 0;
  
