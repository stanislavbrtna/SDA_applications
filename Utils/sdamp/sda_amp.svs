function scrSpacer {
  sys.gui.setSpacing(arg0, 1, 1, 1, 1);
  sys.gui.setXcell(arg0, 34);
  sys.gui.setYcell(arg0, 34);
  sys.gui.setXscroll(arg0, -6 + 16);
  sys.gui.setYscroll(arg0, -6 - 8);
}


function spinnerInit {
  local siz = 32;
  sys.ds.setArea(160 - siz, 220 - siz, 160 + siz, 220 + siz);
  
  sys.ds.fillRect(0, 0, siz * 2, siz * 2, sys.gui.getColor(COL_BACKGROUND));
  sys.ds.drawRect(1, 1, siz * 2 - 1, siz * 2 - 1, sys.gui.getColor(COL_BORDER));
  sys.ds.drawRect(0, 0, siz * 2, siz * 2, sys.gui.getColor(COL_BORDER));
  sys.ds.fillCircle(siz, siz, siz - 5, sys.gui.getColor(COL_FILL));
}

function spinner {
  local siz = 32;
  local spin = (sys.time.getAppUptime() % 1000) / 250;
  local spinOld = spin - 1;
  
  if (spinOld == -1) spinOld = 2;
  
  if(spin == 3) {
    spin = 2;
    spinOld = 3;
  } else if (spin == 2) {
    spin = 3;
    spinOld = 1;
  }
  
  sys.ds.fillCPart(siz, siz, siz - 5, spinOld, sys.gui.getColor(COL_FILL));
  sys.ds.fillCPart(siz, siz, siz - 5, spin, sys.gui.getColor(COL_ACTIVE));
  
}

function dbReset {
  sys.fs.db.new("appdata/sdamp.db");
  
  sys.fs.db.newTable("songs", 5);
  sys.fs.db.setColumn(0, "id", 0);
  sys.fs.db.setColumn(1, "name", 1);
  sys.fs.db.setColumn(2, "path", 1); # full path
  sys.fs.db.setColumn(3, "folderId", 0);
  sys.fs.db.setColumn(4, "len", 0);
  
  sys.fs.db.idEnable("id");
  sys.fs.db.setIndex("id");
  
  sys.fs.db.newTable("folders", 5);
  sys.fs.db.setColumn(0, "id", 0);
  sys.fs.db.setColumn(1, "name", 1);   # path
  sys.fs.db.setColumn(2, "scanAt", 0); # timestamp
  sys.fs.db.setColumn(3, "files", 0);  # number of files
  sys.fs.db.setColumn(4, "total", 0);  # total size of all files in bytes
  
  sys.fs.db.idEnable("id");
  sys.fs.db.setIndex("id");
  
  dbAddFl("music");
  
  sys.fs.db.sync();
}

function getsize {
  local x;
  sys.fs.open(arg0);
  x = sys.fs.size();
  sys.fs.close();
  return x;
}

function getSuppFile {
  return substr(arg0, len(arg0) - 2, len(arg0)) == "mp3" or substr(arg0, len(arg0) - 3, len(arg0)) == "flac";
}

function dbScanFl { # todo: arg0 - folder id
  sys.fs.db.selectTable("folders");
  sys.fs.db.selectRowId(arg0);
  
  local fname = sys.fs.db.getEntryStr("name", "");
  local noSongs = 0;
  local total = 0;
  
  if(sys.fs.db.getEntry("scanAt") != 0) {
    print("dbScanFl: Already scanned: rescan");
    dbRescanFl(arg0);
    return;
  }
  
  print("dbScanFl:" + fname);

  for(local findfil = sys.fs.find("", fname); findfil != ""; findfil = sys.fs.findNext();) {
    print("found: " + findfil);
    # add sub-dirs
    if(sys.fs.isDir(fname + "/" + findfil)) {
      dbAddFl(fname + "/" + findfil);
    } else {
      # add files
      if(getSuppFile(findfil)) {
        print("file: " + fname + "/" + findfil);
        dbAddmp3(findfil, fname + "/" + findfil, arg0);
        total += getsize(fname + "/" + findfil);
        noSongs++;
        
        spinner();
      }
    }
  }
  
  if(noSongs == 0) {
    sys.fs.db.selectTable("folders");
    sys.fs.db.selectRowId(arg0);
    sys.fs.db.dropRow();
    print("no songs, dropping");
    return;
  }
  
  sys.fs.db.selectTable("folders");
  sys.fs.db.selectRowId(arg0);
  sys.fs.db.setEntry("scanAt", sys.time.get());
  sys.fs.db.setEntry("files", noSongs);
  sys.fs.db.setEntry("total", total);
  
  print(noSongs + " files total " + total + " bytes");
}


function dbRescanFl { # todo: arg0 - folder id
  sys.fs.db.selectTable("folders");
  sys.fs.db.selectRowId(arg0);
  
  local fname = sys.fs.db.getEntryStr("name", "");
  local noSongs = 0;
  local total = 0;
  
  # check file count...
  
  for(local findfil = sys.fs.find("", fname); findfil != ""; findfil = sys.fs.findNext();) {
    #print("dbRescanFl: found: " + findfil);
    spinner();
    # add sub-dirs, to be sure
    if(sys.fs.isDir(fname + "/" + findfil)) {
      dbAddFl(fname + "/" + findfil);
    } else {
      # add files
      if(getSuppFile(findfil)) {
        #print("mp3: " + fname + "/" + findfil);
        total += getsize(fname + "/" + findfil);
        noSongs++;
      }
    }
  }
  
  if(total == sys.fs.db.getEntry("total") and noSongs == sys.fs.db.getEntry("files")) {
    print("dbRescanFl: Nothing new in folder id: " + arg0 + "");
    return;
  }
  
  noSongs = 0;
  
  for(local findfil = sys.fs.find("", fname); findfil != ""; findfil = sys.fs.findNext();) {
    # add files
    if(not sys.fs.isDir(fname + "/" + findfil) and getSuppFile(findfil)) {
      #print("mp3: " + fname + "/" + findfil);
      sys.fs.db.selectTable("songs");
      if(sys.fs.db.selectRowStr("path", fname + "/" + findfil, 0, 0)) {
        #print("File already exists...");
      } else {
        dbAddmp3(findfil, fname + "/" + findfil, arg0);
      }
      total += getsize(fname + "/" + findfil);
      noSongs++;
    }
  }
  
  if(noSongs == 0) {
    sys.fs.db.selectTable("folders");
    sys.fs.db.selectRowId(arg0);
    sys.fs.db.dropRow();
    print("dbRescanFl: no songs, dropping");
    return;
  }
  
  sys.fs.db.selectTable("folders");
  sys.fs.db.selectRowId(arg0);
  sys.fs.db.setEntry("scanAt", sys.time.get());
  sys.fs.db.setEntry("files", noSongs);
  sys.fs.db.setEntry("total", total);
  
  print("Rescan:" + noSongs + " files total " + total + " bytes");
}


function dbAddFl {
  print("dbAddFl: adding: " + arg0);
  sys.fs.db.selectTable("folders");
  
  if(sys.fs.db.getRowCount() > 0) {
    sys.fs.db.selectRow(0);
    # ignore existing entries
    if(sys.fs.db.selectRowStr("name", arg0, 0, 0)) {
      print("dbAddFl: Folder already exists...");
      return;
    }
  }
  
  sys.fs.db.newRow();
  sys.fs.db.setEntry("scanAt", 0);
  sys.fs.db.setEntry("name", arg0);
  sys.fs.db.setEntry("files", 0);
  sys.fs.db.setEntry("total", 0);
}

function dbAddmp3 #*name, fullPath, folderId*# {
  print("adding song: " + arg0);
  sys.fs.db.selectTable("songs");
  sys.fs.db.newRow();
  sys.fs.db.setEntry("name", arg0);
  sys.fs.db.setEntry("path", arg1);
  sys.fs.db.setEntry("folderId", arg2);
  sys.fs.db.setEntry("len", sys.pcm.getDuration(arg1) + 1);
}

function dbCheck {
  sys.fs.db.selectTable("folders");
  
  # check folders
  
  while(1) {
    local rows = sys.fs.db.getRowCount();
    
    for(local i = 0; i < rows; i++;) { 
      sys.fs.db.selectTable("folders");
      
      if (not sys.fs.db.selectRow(i)) {
        break;
      }
      
      print("dbCheck: scanning \"" + sys.fs.db.getEntry("name") + "\" id: " + sys.fs.db.getEntry("id"));
      dbScanFl(sys.fs.db.getEntry("id"));
    }
    
    local contScan = 0;
    local rows = sys.fs.db.getRowCount();
    
    for(local i = 0; i < rows; i++;) {
      if (not sys.fs.db.selectRow(i)) {
        break;
      }
      
      if(sys.fs.db.getEntry("scanAt") == 0) {
        print("scan did not finish, continue");
        contScan = 1;
      }
    }
    
    if(not contScan) {
      break;
    }
  }
  
  
  # check file validity
  sys.fs.db.selectTable("songs");
  rows = sys.fs.db.getRowCount();
  
  for(local i = 0; i < rows; i++;) {
    
    if (not sys.fs.db.selectRow(i)) {
      break;
    }
    
    if (not sys.fs.exists(sys.fs.db.getEntry("path"))) {
      print("Song not found, dropping: " + sys.fs.db.getEntry("path"));
      sys.fs.db.dropRow();
      i--;
      rows = sys.fs.db.getRowCount();
      print("dropDone");
    }
  }
    
  # remove empty folders
  sys.fs.db.selectTable("folders");
  
  # check folders
  local rows = sys.fs.db.getRowCount();
  for(local i = 0; i < rows; i++;) {
    if (not sys.fs.db.selectRow(i)) {
      continue;
    }
    
    if(sys.fs.db.getEntry("total") == 0 and sys.fs.db.getEntry("scanAt") != 0) {
      print("Removing empty: " + sys.fs.db.getEntry("name"));
      sys.fs.db.dropRow();
      i--;
      rows--;
    }
  }
  
  # print info
  sys.fs.db.selectTable("folders");
  print("Total folders: " + sys.fs.db.getRowCount());
  sys.fs.db.selectTable("songs");
  print("Total songs: " + sys.fs.db.getRowCount());
}

function dbPrint {
  print("Songs db:");
  sys.fs.db.selectTable("folders");
  
  for(local i = 0; i < 100; i++;) {
    sys.fs.db.selectTable("folders");
    
    if (not sys.fs.db.selectRow(i)) {
      break;
    }
    
    print("Folder: " + sys.fs.db.getEntry("name") + " id: " + sys.fs.db.getEntry("id"));
    local id = sys.fs.db.getEntry("id");
    
    local songs = 0;
    sys.fs.db.selectTable("songs");
    
    sys.fs.db.selectRow(0);
    
    for(local b = 1; b < 300; b++;) {
      if (not sys.fs.db.selectRowNum("folderId", id)) {
        break;
      }
      songs++;
      #print("  " + sys.fs.db.getEntry("name"));
      if (not sys.fs.db.nextRow()) {
        break;
      }
    }
    
    print("  " + songs + " songs total");
  }
  print("done");
}

