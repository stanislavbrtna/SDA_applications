  sys.gui.setYOffset(bStop, 8);
  sys.gui.setXOffset(bStop, 9);
  sys.gui.setIcon(bStop, "stop.sic");

  bNext = sys.gui.addButton(7, 10, 2, 2, "", scr);
  sys.gui.setXOffset(bNext, 16);
  sys.gui.setYOffset(bNext, 8);
  sys.gui.setIcon(bNext, "next.sic");
  
  # Library screen
  sLib = sys.gui.addScreen();
  scrSpacer(sLib);
  sys.gui.setXcell(sLib, 34);
  sys.gui.setXscroll(sLib, 26);
  
  #sLibIn = sys.gui.addScreen(1, 0, 7, 11, sLib);
  
  sLBar = sys.gui.addSliderV(9, 0, 1, 7, 100, 0, sLib);
  bLQueue = sys.gui.addButton(9, 7, 1, 1, "Q", sLib);
  
  bLfolder = sys.gui.addButton(7, 11, 2, 1, "", sLib);
  sys.gui.setIcon(bLfolder, "folder.sic");
  sys.gui.setXOffset(bLfolder, 12);
  sys.gui.setYOffset(bLfolder, 3);
  
  bLSearch = sys.gui.addButton(4, 11, 2, 1, "", sLib);
  sys.gui.setIcon(bLSearch, "search.sic");
  sys.gui.setXOffset(bLSearch, 15);
  
  bLBack = sys.gui.addButton(1, 11, 2, 1, "", sLib);
